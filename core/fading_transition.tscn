[gd_scene format=3 uid="uid://0m4k4dhua4w7"]

[ext_resource type="Texture2D" uid="uid://dhl0kjefxk7ih" path="res://assets/ui/kenney_circle_02.png" id="1_5c2le"]

[sub_resource type="GDScript" id="GDScript_f8rml"]
script/source = "extends CanvasLayer

signal transition_ready

@onready var progress_circle: TextureProgressBar = %Circle
@onready var player: AnimationPlayer = $AnimationPlayer


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	await player.animation_finished
	transition_ready.emit()
	player.play(\"spin\")


func _on_load_finished() -> void:
	player.play_backwards(\"fade\")
	await player.animation_finished
	queue_free()


func _on_progress_changed(progress: float) -> void:
	progress_circle.value = progress
"

